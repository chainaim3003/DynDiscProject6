# Orchestration / memory (locked)
ORCHESTRATOR=langgraph-ts
CHECKPOINTER_KIND=sqlite
AUDIT_DB_PATH=./data/audit.db          # T2 + T5 share this file
MEMORY_STORE_KIND=memory               # memory | sqlite | postgres   (T3)
EMBEDDING_MODEL=text-embedding-004
CLARIFY_MAX_ROUNDS=2
NEGOTIATION_MAX_ROUNDS=3
QUOTE_DEMAND_AWARE=off                 # on = Quoting consults Demand-Planning ([P09], [P10])
IDEMPOTENT_WRITES=on                   # on = dedupe ERPNext writes by negotiationId (gap G3); off = blind insert (legacy)
NEGOTIATION_OPTIMIZER=llm
GEMINI_API_KEY=<your Google AI Studio key>
NEGOTIATION_LLM_TEMPERATURE=0.1
NEGOTIATION_LLM_MODEL=gemini-2.5-flash

# Buyer transport (Improvement 1 — network A2A)
BUYER_TRANSPORT=inprocess               # inprocess (default, in-process buyer) | a2a (networked buyer server)
BUYER_A2A_URL=http://localhost:41242    # a2a: buyer server base URL (card at <url>/.well-known/agent-card.json)
BUYER_A2A_PORT=41242                    # a2a: port the buyer server (src/servers/buyer-server.ts) listens on
BUYER_A2A_TIMEOUT_MS=10000              # a2a: per-call timeout (ms) for the seller→buyer request

# Provider modes (locked)
INVENTORY_MODE=real                    # ERPNext Bin
CREDIT_MODE=real                       # GLEIF live; EDGAR demo
LOGISTICS_MODE=demo
TREASURY_MODE=real                     # ACTUS PAM
CREDENTIAL_MODE=plain                  # vlei -> ITER7
SIGNING_MODE=plain                     # sha256 envelope

# ERPNext (T4)
ERPNEXT_URL=http://localhost:8080
ERPNEXT_API_KEY=<your_api_key_here>
ERPNEXT_API_SECRET=<your_api_secret_here>
ERPNEXT_COMPANY=Jupiter Knitting Company
ERPNEXT_CURRENCY=INR
ERPNEXT_DEFAULT_WAREHOUSE=MADRAS-WH-1
QUOTE_PERSIST_MODE=final               # final | every-round (Schemas doc 2.5)
PAYMENT_TERMS_ALLOWED=Net-0,Net-30,Net-60
GST_RATE=18
TREASURY_MODE=demo

# Eval modes
EVAL_MODE=fast                         # fast | integration | e2e

# -- Identity / vLEI integration (HOST A -> HOST B vLEIEnh1) -------------------
# When CREDENTIAL_MODE=plain (above), NONE of the HOST_B URLs are read -- local
# dev stays fully self-contained. They activate only under CREDENTIAL_MODE=vlei.
# (Surface defined in REFINED-Project-Structure.md section 4.)
AGENT_CARDS_DIR=./agent-cards          # principal cards (design target: ./identity/agent-cards)
SUBAGENT_CARDS_DIR=./identity/agent-cards/subagents
BINDING_MAP=./identity/binding-map.json
VLEI_API_URL=                          # e.g. http://<HOST_B_IP>:4000  (/api/verify/seller|buyer)
SALLY_VERIFIER_URL=                    # e.g. http://<HOST_B_IP>:9723  (counterparty chain walk)
KERIA_ADMIN_URL=                       # e.g. http://<HOST_B_IP>:3901
KERIA_BOOT_URL=                        # e.g. http://<HOST_B_IP>:3903
SCHEMA_OOBI_URL=                       # e.g. http://<HOST_B_IP>:7723
VLEI_VERIFY_REQUIRED=false             # true = refuse to quote unless counterparty AID verifies
